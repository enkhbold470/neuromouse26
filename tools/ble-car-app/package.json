{
  "name": "mm26-ble-car-app",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Web Bluetooth RC controller for the Micromouse26 BLE Car menu mode.",
  "engines": {
    "node": ">=18.13"
  },
  "type": "module",
  "scripts": {
    "dev": "vite dev --host",
    "build": "vite build",
    "preview": "vite preview --host",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "start": "sirv build --host 0.0.0.0 --port ${PORT:-8000} --single --quiet"
  },
  "dependencies": {
    "sirv-cli": "^3.0.0"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.6",
    "@sveltejs/kit": "^2.8.0",
    "@sveltejs/vite-plugin-svelte": "^4.0.0",
    "@types/web-bluetooth": "^0.0.20",
    "svelte": "^5.57.0",
    "svelte-check": "^4.0.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.0"
  }
}
